EDGE_NOTE_ENV=development
EDGE_NOTE_HOST=127.0.0.1
EDGE_NOTE_PORT=3000
EDGE_NOTE_PUBLIC_URL=http://localhost:3000
EDGE_NOTE_OWNER_USER_ID=1
EDGE_NOTE_SESSION_SECRET=replace-with-a-long-random-secret

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=edge_note
MYSQL_USER=edge_note
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=5

ATTACHMENT_ROOT=./uploads
BACKUP_ROOT=./backups

# Groq (OpenAI-compatible). See docs/ai-production.md for Gemini or other providers.
AI_ENDPOINT_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL_NAME=openai/gpt-oss-120b
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=800
