{
  "name": "edge-note",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first notes workspace built for Hostinger Node and MySQL.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mysql2": "^3.11.5"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "EDGE_NOTE_ENV=development node src/server.js",
    "check": "for file in src/*.js public/*.js scripts/*.js; do node --check \"$file\"; done",
    "verify": "npm run check && node scripts/verify-setup.js",
    "verify:prod-env": "node scripts/check-production-env.js",
    "verify:ai": "node scripts/check-ai-endpoint.js",
    "verify:data": "node scripts/check-data-safety.js",
    "verify:daily": "node scripts/check-daily-use.js",
    "smoke:prod": "node scripts/smoke-production.js"
  }
}
